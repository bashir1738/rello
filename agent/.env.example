# Agent execution mode (false = log-only, true = live swaps)
FEATURE_FLAG_EXECUTION=false

# Agent wallet private key (JSON array format: [1,2,3,...])
AGENT_WALLET_PRIVATE_KEY=

# Meteora DBC pool address for corrective swaps
METEORA_POOL_ADDRESS=

# Discord webhook for alerts (optional)
DISCORD_WEBHOOK_URL=

# Slack webhook for alerts (optional)
SLACK_WEBHOOK_URL=

# Solana RPC (used for Meteora swap execution)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Agent polling interval in milliseconds
POLL_INTERVAL_MS=10000

# Swap threshold in basis points (default: 50)
SWAP_THRESHOLD_BPS=50

# Max trade amount per correction (default: 1000)
MAX_TRADE_AMOUNT=1000
