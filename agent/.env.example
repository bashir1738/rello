# Agent execution mode (false = log-only, true = live swaps)
FEATURE_FLAG_EXECUTION=false

# Discord webhook for alerts (optional)
DISCORD_WEBHOOK_URL=

# Solana RPC (used for Meteora swap execution)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Agent polling interval in milliseconds
POLL_INTERVAL_MS=10000
